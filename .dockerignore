# What az acr build / docker build must NOT send to the image build.
# Secrets and machine-specific folders stay out; the image installs its own
# dependencies on Linux and gets its settings from the Container App.
.git
.github
.claude
.env*
node_modules
.next
npm-debug.log*
*.log

# Not needed to build or run the app
__tests__
docs
playwright-report
test-results
coverage
*.md
skills-lock.json
