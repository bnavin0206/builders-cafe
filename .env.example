MIXOLOGIST_LOGIN=someuser:somepassword
ADMIN_LOGIN=someadmin:otherpassword
KIOSK_LOGIN=somekiosk:somepassword
SERVICE_INSTANCE_PREFIX=Mixologist
UNLIMITED_ORDERS=CommaSeparatedNumbersToWhichTheLimitDoesNotApply

# Twilio related values
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=FOR_SIGNATURE_VERIFICATION
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SYNC_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=

# Optional: SendGrid dynamic template IDs (d-...) for Verify emails, per event
# language. Sources live in resources/sendgridTemplate-*.html. Unset languages
# use the Verify service's default template.
SENDGRID_TEMPLATE_EN=
SENDGRID_TEMPLATE_PTBR=
SENDGRID_TEMPLATE_FR=

# NGROK URL GOES HERE
PUBLIC_BASE_URL=

# Lead collection mode: MANUAL (default) | NONE | QR
LEAD_COLLECTION=MANUAL
# Shown in verification emails (MANUAL mode)
EVENT_NAME=

# Optional: Segment Profiles enrichment
SEGMENT_SPACE_ID=
SEGMENT_PROFILE_KEY=
SEGMENT_TRAIT_CHECK=

# Optional: QR mode — Twilio Customer Memory
# TWILIO_CONVERSATION_CONFIGURATION_ID=
# TWILIO_MEMORY_STORE_ID=

# Optional: QR mode — badge scan API key
# BADGE_API_KEY=

# Razorpay: use test keys until go-live. Webhook URL: <PUBLIC_BASE_URL>/webhooks/razorpay,
# event "payment_link.paid", secret = RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Leads: each verified sign-up is posted as signed JSON to this URL, where the
# client's side writes it to their database. Leave empty to skip. The body is
# signed with HMAC-SHA256 in the X-Signature header when the secret is set.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
